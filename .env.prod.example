# Production settings for docker-compose.prod.yml — see docs/deploy-contabo.md.
# On the server: cp .env.prod.example .env.prod, then replace every "change-me" value.
# Never commit .env.prod (it's gitignored).
#
# Generate passwords with:  openssl rand -hex 24
# (hex only, so they're safe inside DATABASE_URL without escaping)

# --- Domains (DNS A records at Spaceship all point to the VPS IP) ---
SHOP_DOMAIN=mangimall.com
API_DOMAIN=api.mangimall.com
MEDIA_DOMAIN=media.mangimall.com
# Let's Encrypt sends certificate-expiry warnings here
ACME_EMAIL=you@example.com

# --- Django ---
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Postgres ---
POSTGRES_USER=emall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emall

# --- MinIO (product images) ---
MINIO_ROOT_USER=emall-minio
MINIO_ROOT_PASSWORD=change-me

# --- First admin account (created on first start by seed_admin) ---
ADMIN_SEED_EMAIL=admin@mangimall.com
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_NAME=Site Administrator

# --- Email (verification / password-reset OTPs) via Gmail ---
# EMAIL_HOST_PASSWORD must be a Google App Password (Google Account > Security >
# 2-Step Verification > App passwords), not your normal Gmail password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=MangiMall <you@gmail.com>

# --- Customer payments (AzamPay mobile money) ---
# Keep "mock" until AzamPay credentials are issued; then set "azampay" and fill in the rest.
# Never use "azampay_simulator" here: it exposes unauthenticated approve/reject endpoints.
# Callback URL to register in the AzamPay portal:
#   https://api.mangimall.com/api/payments/azampay/callback/<AZAMPAY_CALLBACK_TOKEN>
PAYMENT_BACKEND=mock
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
# Sandbox hosts; switch to the live hosts AzamPay gives you when going live.
AZAMPAY_AUTH_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_API_URL=https://sandbox.azampay.co.tz
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AZAMPAY_CALLBACK_TOKEN=change-me
PAYMENT_PENDING_TIMEOUT_MINUTES=15

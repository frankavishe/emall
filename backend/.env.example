# Copy to backend/.env and fill in real values for your machine.
# Never commit backend/.env (see .gitignore).

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml's db service by default
DATABASE_URL=postgres://emall:emall_dev_password@localhost:5433/emall

CORS_ALLOWED_ORIGINS=http://localhost:3000

# console = prints emails to the runserver console (Constitution Principle IV: mocked edge)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@emall.local

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Used only by apps/accounts/management/commands/seed_admin.py
ADMIN_SEED_EMAIL=admin@emall.local
ADMIN_SEED_PASSWORD=change-me-too
ADMIN_SEED_NAME=Site Administrator

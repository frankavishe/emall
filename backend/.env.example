# Copy to backend/.env and fill in real values for your machine.
# Never commit backend/.env (see .gitignore).

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml's db service by default
DATABASE_URL=postgres://emall:emall_dev_password@localhost:5433/emall

CORS_ALLOWED_ORIGINS=http://localhost:3000

# console = prints emails to the runserver console (Constitution Principle IV: mocked edge)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@emall.local

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Used only by apps/accounts/management/commands/seed_admin.py
ADMIN_SEED_EMAIL=admin@emall.local
ADMIN_SEED_PASSWORD=change-me-too
ADMIN_SEED_NAME=Site Administrator

# Object storage for product images (MinIO locally/in CI staging; swappable for real S3/R2
# later purely via these env vars). Matches docker-compose.yml's minio service by default.
USE_S3_MEDIA=True
AWS_ACCESS_KEY_ID=emall-minio
AWS_SECRET_ACCESS_KEY=emall_dev_password
AWS_STORAGE_BUCKET_NAME=emall-media
# Backend runs natively in local dev (only db/minio run in docker-compose), so the endpoint
# Django writes to and the host browsers read from are both localhost — no need to set
# AWS_S3_CUSTOM_DOMAIN separately here (it only matters where those two hosts differ, e.g.
# docker-compose.staging.yml, where backend is itself a container reaching minio:9000
# internally while browsers need localhost:9000).
AWS_S3_ENDPOINT_URL=http://localhost:9000
